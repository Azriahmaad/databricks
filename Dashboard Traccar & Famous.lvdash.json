{
  "datasets": [
    {
      "name": "f0d98efd",
      "displayName": "Speed Trend",
      "queryLines": [
        "SELECT\r\n",
        "    tanggal,\r\n",
        "    kecepatan,\r\n",
        "    jumlah_transaksi,\r\n",
        "    -- Hitung Total Transaksi Harian\r\n",
        "    SUM(jumlah_transaksi) OVER (PARTITION BY tanggal) AS total_harian,\r\n",
        "    -- Hitung Persentase Harian \r\n",
        "    (jumlah_transaksi * 100.0) / SUM(jumlah_transaksi) OVER (PARTITION BY tanggal) AS percentage_of_day\r\n",
        "FROM daily_speed_trend\r\n",
        "WHERE tanggal BETWEEN \r\n",
        "    (SELECT MIN(tanggal) FROM daily_speed_trend)\r\n",
        "    AND\r\n",
        "    (SELECT MAX(tanggal) FROM daily_speed_trend)\r\n",
        "ORDER BY tanggal, percentage_of_day DESC\r\n",
        "\r\n"
      ],
      "catalog": "poc",
      "schema": "gold"
    },
    {
      "name": "2c3f3673",
      "displayName": "Company Comply",
      "queryLines": [
        "SELECT\r\n",
        "    company_code,\r\n",
        "    CASE\r\n",
        "        -- Karena compliance_value adalah desimal (0.0 - 1.0), kita harus mengalikan 100\r\n",
        "        WHEN compliance_value * 100.0 < 70 THEN 'Partially Comply (60%-70%)'\r\n",
        "        WHEN compliance_value * 100.0 >= 70 AND compliance_value * 100.0 <= 80 THEN 'Nearly Comply (70%-80%)'\r\n",
        "        WHEN compliance_value * 100.0 > 80 THEN 'Full Comply (> 80%)'\r\n",
        "        ELSE 'Undefined'\r\n",
        "    END AS compliance_category,\r\n",
        "    \r\n",
        "    -- Hitung frekuensi (Jumlah Hari) setiap perusahaan masuk ke kategori tersebut\r\n",
        "    COUNT(report_date) AS frequency_count \r\n",
        "FROM daily_company_comply\r\n",
        "WHERE\r\n",
        "    report_date BETWEEN '2025-10-29' AND '2025-11-05'\r\n",
        "GROUP BY \r\n",
        "    company_code,\r\n",
        "    compliance_category\r\n",
        "ORDER BY \r\n",
        "    company_code, frequency_count DESC"
      ],
      "catalog": "poc",
      "schema": "gold"
    },
    {
      "name": "b6e01eb7",
      "displayName": "7 - 10 Kpj Trend",
      "queryLines": [
        "WITH RankedData AS (\r\n",
        "    -- 1. Hitung Total Transaksi Harian dan Persentase per Kategori\r\n",
        "    SELECT\r\n",
        "        tanggal,\r\n",
        "        kecepatan,\r\n",
        "        jumlah_transaksi,\r\n",
        "        -- Hitung Total Transaksi untuk seluruh kategori pada tanggal yang sama\r\n",
        "        SUM(jumlah_transaksi) OVER (PARTITION BY tanggal) AS total_harian,\r\n",
        "        -- Hitung Persentase\r\n",
        "        (jumlah_transaksi * 100.0) / SUM(jumlah_transaksi) OVER (PARTITION BY tanggal) AS percentage_of_day,\r\n",
        "        -- Tentukan urutan tanggal untuk memudahkan pemilihan tanggal terbaru\r\n",
        "        ROW_NUMBER() OVER (ORDER BY tanggal DESC) AS rn\r\n",
        "    FROM\r\n",
        "        daily_speed_trend -- Ganti dengan nama tabel Anda yang sebenarnya\r\n",
        ")\r\n",
        "SELECT\r\n",
        "    tanggal,\r\n",
        "    percentage_of_day AS persentase_7_10_kpj_terkini\r\n",
        "FROM\r\n",
        "    RankedData\r\n",
        "WHERE\r\n",
        "    -- Filter untuk mengambil kategori yang diinginkan\r\n",
        "    kecepatan = 'Antara 7 Kpj sampai 10 Kpj'\r\n",
        "    AND\r\n",
        "    -- Filter untuk mengambil hanya tanggal terkini (rn=1)\r\n",
        "    rn = 1;"
      ],
      "catalog": "poc",
      "schema": "gold"
    },
    {
      "name": "9c99400e",
      "displayName": "Real Time Fleet Device Location Snapshot",
      "queryLines": [
        "-- Save as query: \"Fleet Live Position\"\r\n",
        "WITH latest_positions AS (\r\n",
        "  SELECT \r\n",
        "    p.*,\r\n",
        "    ROW_NUMBER() OVER (PARTITION BY p.deviceid ORDER BY p.servertime DESC) as rn\r\n",
        "  FROM tc.default.tc_positions p\r\n",
        ")\r\n",
        "SELECT \r\n",
        "  d.name as device_name,\r\n",
        "  d.status,\r\n",
        "  lp.latitude,\r\n",
        "  lp.longitude,\r\n",
        "  lp.speed,\r\n",
        "  lp.servertime as last_update\r\n",
        "FROM tc.default.tc_devices d\r\n",
        "JOIN latest_positions lp ON d.id = lp.deviceid AND lp.rn = 1\r\n",
        "WHERE lp.latitude IS NOT NULL"
      ],
      "catalog": "tc",
      "schema": "default"
    },
    {
      "name": "65dcbc53",
      "displayName": "Top 5 lokasi KM terjelek",
      "queryLines": [
        "SELECT\r\n",
        "  KM AS `Lokasi KM`,\r\n",
        "  CAST(AVG(rerata_jarak_waktu) AS INT) AS `Rata-rata Jarak Waktu`\r\n",
        "FROM\r\n",
        "  tc.default.gold_v_famous_jarak_aman_km\r\n",
        "WHERE\r\n",
        "  week_of_year = '2025-W08'\r\n",
        "GROUP BY\r\n",
        "  KM\r\n",
        "ORDER BY\r\n",
        "  AVG(rerata_jarak_waktu) ASC\r\n",
        "LIMIT 5"
      ]
    },
