{
  "datasets": [
    {
      "name": "speed_trend",
      "displayName": "Speed Trend",
      "queryLines": [
        "SELECT\n",
        "  tanggal,\n",
        "  kecepatan,\n",
        "  jumlah_transaksi,\n",
        "  -- Hitung Total Transaksi Harian\n",
        "  SUM(jumlah_transaksi) OVER (PARTITION BY tanggal) AS total_harian,\n",
        "  -- Hitung Persentase Harian\n",
        "  (jumlah_transaksi * 100.0)\n",
        "    / SUM(jumlah_transaksi) OVER (PARTITION BY tanggal) AS percentage_of_day\n",
        "FROM\n",
        "  workspace.gold.daily_speed_trend\n",
        "WHERE\n",
        "  tanggal BETWEEN\n",
        "    (\n",
        "      SELECT\n",
        "        MIN(tanggal)\n",
        "      FROM\n",
        "        workspace.gold.daily_speed_trend\n",
        "    )\n",
        "  AND\n",
        "    (\n",
        "      SELECT\n",
        "        MAX(tanggal)\n",
        "      FROM\n",
        "        workspace.gold.daily_speed_trend\n",
        "    )\n",
        "ORDER BY\n",
        "  tanggal,\n",
        "  percentage_of_day DESC"
      ],
      "catalog": "workspace",
      "schema": "gold"
    }
  ],
  "pages": [
