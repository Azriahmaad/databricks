{
  "datasets": [
    {
      "name": "silver_tonnage_flow",
      "displayName": "Silver Tonnage Flow",
      "queryLines": [
        "SELECT\n",
        "  adjusted_date,\n",
        "  flow_mode,\n",
        "  shift,\n",
        "  SUM(tonnage_delta) AS total_tonnage,\n",
        "  SUM(delta_volume) AS total_volume,\n",
        "  COUNT(*) AS reading_count\n",
        "FROM\n",
        "  uc.uscavis.silver_tonnage_cleaned\n",
        "WHERE\n",
        "  tonnage_delta IS NOT NULL\n",
        "  AND flow_mode IN ('direct', 'non_direct')\n",
        "GROUP BY\n",
        "  adjusted_date,\n",
        "  flow_mode,\n",
        "  shift\n",
        "ORDER BY\n",
        "  adjusted_date,\n",
        "  flow_mode"
      ]
    },
    {
      "name": "gold_output_summary",
      "displayName": "Gold Output Summary",
      "queryLines": [
        "SELECT\n",
        "  *\n",
        "FROM\n",
        "  uc.uscavis.gold_output_summary"
      ]
    },
    {
      "name": "gold_wim_cv_ratio",
      "displayName": "Gold WIM CV Ratio",
      "queryLines": [
        "SELECT\n",
        "  *\n",
        "FROM\n",
        "  uc.uscavis.gold_wim_cv_ratio"
      ]
    }
  ],
