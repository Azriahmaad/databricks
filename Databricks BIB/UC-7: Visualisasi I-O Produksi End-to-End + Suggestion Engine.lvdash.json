{
  "datasets": [
    {
      "name": "contractor_daily",
      "displayName": "Contractor Daily",
      "queryLines": [
        "SELECT\n",
        "  *\n",
        "FROM\n",
        "  uc.uc07.gold_contractor_daily\n",
        "ORDER BY\n",
        "  production_date DESC,\n",
        "  netto_ton DESC"
      ]
    },
    {
      "name": "stockpile_balance",
      "displayName": "Stockpile Balance Hourly",
      "queryLines": [
        "SELECT\n",
        "  *\n",
        "FROM\n",
        "  uc.uc07.gold_stockpile_balance_hourly\n",
        "ORDER BY\n",
        "  hour_start_utc"
      ]
    },
    {
      "name": "kpi_snapshot",
      "displayName": "KPI Snapshot",
      "queryLines": [
        "SELECT\n",
        "  *\n",
        "FROM\n",
        "  uc.uc07.gold_kpi_snapshot\n",
        "ORDER BY\n",
        "  production_date DESC"
      ]
    },
    {
      "name": "funnel_stage_daily",
      "displayName": "Funnel Stage Daily",
      "queryLines": [
        "SELECT\n",
        "  *\n",
        "FROM\n",
        "  uc.uc07.gold_funnel_stage_daily\n",
        "WHERE\n",
        "  is_estimated = false\n",
        "ORDER BY\n",
        "  production_date,\n",
        "  stage_seq"
      ]
    },
    {
      "name": "stage_reconciliation",
      "displayName": "Stage Reconciliation",
      "queryLines": [
        "SELECT\n",
        "  *\n",
        "FROM\n",
        "  uc.uc07.gold_stage_reconciliation\n",
        "WHERE\n",
        "  loss_pct IS NOT NULL\n",
        "  AND severity != 'NO_DATA'\n",
        "ORDER BY\n",
        "  production_date,\n",
        "  upstream_stage"
      ]
    },
    {
      "name": "suggestion_daily",
      "displayName": "Suggestion Daily",
      "queryLines": [
        "SELECT\n",
        "  *\n",
        "FROM\n",
        "  uc.uc07.gold_suggestion_daily\n",
        "ORDER BY\n",
        "  production_date DESC,\n",
        "  rank"
      ]
    },
    {
      "name": "production_timeseries",
      "displayName": "Production Timeseries",
      "queryLines": [
        "SELECT\n",
        "  period_start,\n",
        "  'Aktual' AS series,\n",
        "  actual_ton AS tonnage\n",
        "FROM\n",
        "  uc.uc07.gold_production_timeseries\n",
        "WHERE\n",
        "  grain = 'DAILY'\n",
        "UNION ALL\n",
        "SELECT\n",
        "  period_start,\n",
        "  'Target' AS series,\n",
        "  target_ton AS tonnage\n",
        "FROM\n",
        "  uc.uc07.gold_production_timeseries\n",
        "WHERE\n",
        "  grain = 'DAILY'\n",
        "ORDER BY\n",
        "  period_start,\n",
        "  series"
      ]
    }
  ],
